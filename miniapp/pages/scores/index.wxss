button::after {
  border: none;
}

.score-card,
.trend-card {
  margin-bottom: 18rpx;
}

.score-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 16rpx;
}

.score-head-main {
  flex: 1;
  min-width: 0;
}

.refresh-btn {
  margin-top: 0;
  margin-left: auto;
  width: auto;
  min-width: 176rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}

.score-item {
  margin-top: 14rpx;
  padding: 18rpx;
  border: 2rpx solid #d8e5f8;
  border-radius: 14rpx;
  background: linear-gradient(180deg, #fbfdff 0%, #f5f9ff 100%);
}

.score-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.score-title {
  flex: 1;
  min-width: 0;
  font-weight: 600;
  margin-bottom: 8rpx;
  color: #2a3450;
  line-height: 1.5;
}

.trend-canvas-wrap {
  width: 100%;
  margin-top: 18rpx;
  overflow: hidden;
}

.rank-chip {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #225fbb;
  background: #e9f2ff;
}

.score-value {
  margin-top: 6rpx;
  color: #0f6ccf;
  font-size: 30rpx;
  font-weight: 600;
}

.trend-canvas {
  display: block;
  width: 100%;
  border-radius: 14rpx;
  border: 2rpx solid #e5ebf5;
  background: #ffffff;
  box-sizing: border-box;
}

.loading-strip {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #5d6f94;
  font-size: 24rpx;
}

.loading-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #3479f5;
  animation: pulse-dot 1.1s ease-in-out infinite;
}

.empty-tip {
  margin-top: 18rpx;
}

@keyframes pulse-dot {
  0% {
    opacity: 0.35;
    transform: scale(0.8);
  }

  50% {
    opacity: 1;
    transform: scale(1.1);
  }

  100% {
    opacity: 0.35;
    transform: scale(0.8);
  }
}
