<view class="page-wrap">
  <view class="card">
    <view class="section-title">通知与资料</view>
    <button class="btn-primary" loading="{{loading}}" bindtap="loadNotices">刷新列表</button>

    <view wx:if="{{loading}}" class="loading-strip">
      <view class="loading-dot"></view>
      <text>通知加载中...</text>
    </view>

    <view wx:if="{{notices.length === 0}}" class="muted" style="margin-top: 18rpx;">暂无通知</view>

    <view wx:for="{{notices}}" wx:key="index" class="notice-item">
      <view class="notice-title">{{item.title}}</view>
      <view class="muted">类型：{{item.notice_type}} | 时间：{{item.created_at}}</view>
      <view class="notice-content">{{item.content}}</view>
    </view>
  </view>
</view>
